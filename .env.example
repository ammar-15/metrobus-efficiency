# Copy to .env and edit. Everything is optional; defaults work out of the box.

# --- Data ---------------------------------------------------------------------
# Official Metrobus GTFS feed. If it fails, the MobilityDatabase mirrors are tried.
GTFS_URL=http://www.metrobustransit.ca/google/google_transit.zip
# GTFS_FALLBACK_URL=https://files.mobilitydatabase.org/mdb-758/latest.zip
# Use a zip you downloaded yourself instead:
# GTFS_PATH=data/google_transit.zip

# --- Maps -------------------------------------------------------------------------
# Optional: free key from https://openrouteservice.org/dev/#/signup
# With it, lines on map.html follow real streets. Without it, lines join stops directly.
ORS_API_KEY=

# --- Hubs -------------------------------------------------------------------------
N_HUBS=10                # how many hubs (transfer points) to pick
HUB_MIN_SPACING_M=1200   # hubs must be at least this far apart
HUB_MIN_SHARE=0.12       # skip hubs less than 12% as busy as the busiest one

# --- Trunk lines ------------------------------------------------------------------
TRUNK_HEADWAY_MIN=10     # a bus every N minutes
MAX_TRUNK_MIN=45         # split one-way trips longer than this
MIN_TRUNK_MIN=12         # join shorter lines onto a neighbour
TRUNK_STOP_SPACING_M=400 # consolidated stop spacing on trunks
TRUNK_CATCHMENT_M=400    # walking distance that counts as "served by a trunk"

# --- Feeder lines -----------------------------------------------------------------
FEEDER_HEADWAY_MIN=30
MAX_LOOP_MIN=30          # feeders longer than 1.5x this get flagged
MIN_LOOP_STOPS=3         # feeders with fewer new stops get flagged for on-demand
FEEDER_JOIN_GAP_MIN=6    # join pieces of a route split by a short trunk stretch

# --- Service assumptions ----------------------------------------------------------
SERVICE_HOURS_PER_WEEKDAY=18
LAYOVER_FACTOR=1.10      # 10% recovery time per cycle when counting buses
MERGE_RADIUS_M=60        # stops this close (opposite sides of a street) are one place
